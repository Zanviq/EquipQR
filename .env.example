# docker compose up 으로 실행할 때는 POSTGRES_PASSWORD만 있으면 된다.
# compose가 컨테이너 내부 DATABASE_URL(host=db)을 직접 만든다. URL에 쓰이므로 비밀번호에 @ : / 는 넣지 않는다.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432
# 로컬 compose에서 데모 계정(demo / demo1234)과 장비 seed 여부
SEED_DEMO=true

# 호스트에서 npm run dev / 테스트를 실행할 때 사용하는 DB 주소
DATABASE_URL=postgresql://equipqr:change-me@localhost:55432/equipqr
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false

# 운영(compose.production.yaml)에서만 사용. Cloudflare Zero Trust > Networks > Tunnels에서 발급
CLOUDFLARE_TUNNEL_TOKEN=
# 운영 예시: APP_ORIGIN=https://equipqr.company.example
